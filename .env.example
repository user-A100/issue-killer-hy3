# Optional: configure a server-side Hy3 key.
# Leave blank to use the BYOK field in the web UI.
HY3_API_KEY=

HY3_BASE_URL=https://tokenhub-intl.tencentcloudmaas.com/v1
HY3_MODEL=hy3
# Optional: 10,000–180,000 ms. Local default is 90,000 ms.
HY3_TIMEOUT_MS=90000

# Optional read-only token to raise GitHub API rate limits.
GITHUB_TOKEN=
